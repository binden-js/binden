    "prebuild": "node ../../scripts/clean.mjs",
    "prepack": "npm run build",
    "test": "node ../../scripts/test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binden-js/binden.git",
    "directory": "packages/logger"
  },
  "keywords": [
