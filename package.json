{
  "name": "binden-monorepo",
  "private": true,
  "description": "binden HTTP framework and its official packages",
  "type": "module",
  "workspaces": [
    "packages/logger",
    "packages/binden",
    "packages/body",
    "packages/compression",
    "packages/multipart"
  ],
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.11.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "ci:all": "npm ci && npm audit signatures && npm audit --omit=dev --audit-level=high && npm run release:check && npm run prettier && npm run commitlint && npm run eslint && npm run test:tooling && npm run coverage && npm run pack:check && npm run consumer:check && npm run release:rehearsal && npm run docs:build",
    "commitlint": "commitlint --verbose --from=origin/main",
    "consumer:check": "node scripts/consumer-check.mjs",
    "coverage": "c8 npm test --",
    "docs:build": "typedoc",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "pack:check": "node scripts/pack-check.mjs",
    "prepare": "husky && npm run build",
    "prettier": "prettier -c .",
    "prettier:write": "prettier -c -w .",
    "release:check": "node scripts/release.mjs check",
    "release:rehearsal": "node scripts/release-rehearsal.mjs",
    "test": "npm test --workspaces --if-present --",
    "test:tooling": "node --test --test-timeout=120000 scripts/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binden-js/binden.git"
  },
  "author": "Sergey Bakulin <sergey.bakulin.github@gmail.com>",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@types/node": "^24.19.2",
    "c8": "^12.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
